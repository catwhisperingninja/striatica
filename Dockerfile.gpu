# striatica pipeline — GPU variant for Vast.ai / Lambda / cloud GPU instances
# CUDA 12.4 + Python 3.12 + PyTorch with CUDA support
#
# Build:
#   docker build -f Dockerfile.gpu -t striatica-pipeline:gpu .
#
# Run:
#   docker run --gpus all -v $(pwd)/output:/app/output -it \
#     striatica-pipeline:gpu bash

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04@sha256:517da2300c184c9999ec203c2665244bdebd3578d12fcc7065e83667932643d9

ENV DEBIAN_FRONTEND=noninteractive

# Python 3.12 from deadsnakes PPA (not in base Ubuntu 22.04)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        build-essential \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python

# Bootstrap the pinned installer separately from the application environment.
RUN python -m venv /opt/poetry \
    && /opt/poetry/bin/pip install --no-cache-dir "poetry==2.5.1"

WORKDIR /app

# Stream CLI and child-process output immediately, including without a TTY.
ENV PYTHONUNBUFFERED=1

ENV POETRY_VIRTUALENVS_IN_PROJECT=true
ENV PATH="/app/.venv/bin:/opt/poetry/bin:$PATH"

# Use the same locked dependencies as the CPU image, including PyTorch's CUDA
# libraries. Do not replace locked torch with an unpinned CUDA-index install.
COPY pyproject.toml poetry.lock ./
# Reuse downloads across builds without shipping the installer cache.
RUN --mount=type=cache,target=/root/.cache \
    poetry install --extras ml --no-root --no-interaction --no-ansi

# Copy source and install only the project (striat entrypoint).
COPY pipeline/ pipeline/
COPY scripts/ scripts/
COPY tests/ tests/
RUN poetry install --only-root --no-interaction --no-ansi

RUN mkdir -p /app/output /app/data
ENV STRIATICA_OUTPUT_DIR=/app/output
ENV STRIATICA_DATA_DIR=/app/data

# Smoke test at build time
RUN python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA build: {torch.version.cuda}'); assert torch.backends.cuda.is_built()"
RUN python -c "from pipeline.vectors import load_transcoder_vectors; print('transcoder loader OK')"

ENTRYPOINT ["python", "-m", "pipeline.cli"]
CMD ["--help"]
